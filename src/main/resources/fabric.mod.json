{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Mixces",
		"lowercasebtw"
	],
	"contributors": [
		"Tellinq",
		"MicrocontrollersDev",
		"Wyvest"
	],
	"contact": {
		"sources": "https://github.com/Legacy-Visuals-Project/Animatium/",
		"issues": "https://github.com/Legacy-Visuals-Project/Animatium/issues"
	},
	"license": "${license}",
	"icon": "assets/animatium/icon.png",
	"accessWidener": "animatium.accesswidener",
	"environment": "client",
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${mcdep}",
		"fabric-networking-api-v1": "*",
		"fabric-command-api-v2": "*",
		"fabric-resource-loader-v0": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "${discord}",
				"modmenu.modrinth": "${modrinth}",
				"modmenu.curseforge": "${curseforge}"
			},
			"update_checker": true
		}
	},
	"recommends": {
		"optiboxes": "*",
		"legacy_potion_colors": "*",
		"polytone": "*",
		"viafabricplus": "*"
	}
}

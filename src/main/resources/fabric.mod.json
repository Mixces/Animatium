{
	"schemaVersion": 1,
	"id": "animatium",
	"version": "${version}",
	"name": "Animatium",
	"description": "Visual Tweaks/QOL Settings For Modern Minecraft Versions, Aimed At 1.7/1.8 players.",
	"authors": [
		"Mixces",
		"lowercasebtw"
	],
	"contributors": [
		"Tellinq",
		"MicrocontrollersDev",
		"Wyvest"
	],
	"contact": {
		"sources": "https://github.com/Legacy-Visuals-Project/Animatium/",
		"issues": "https://github.com/Legacy-Visuals-Project/Animatium/issues"
	},
	"license": "GPL-3.0",
	"icon": "assets/animatium/icon.png",
	"accessWidener": "animatium.accesswidener",
	"environment": "client",
	"entrypoints": {
		"client": [
			"btw.mixces.animatium.AnimatiumClient"
		],
		"modmenu": [
			"btw.mixces.animatium.config.ModMenuIntegration"
		]
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/U48eDmst68"
			},
			"update_checker": true
		}
	},
	"mixins": [
		{
			"config": "animatium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.7",
		"minecraft": [
			">=1.21.9",
			"<1.21.11"
		],
		"fabric-networking-api-v1": "*",
		"fabric-command-api-v2": "*",
		"fabric-resource-loader-v0": "*"
	},
	"recommends": {
		"legacy_potion_colors": "*",
		"optiboxes": "*",
		"polytone": "*",
		"viafabricplus": "*"
	}
}